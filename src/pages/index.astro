---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="David Recalde — Cultural Industries & Communication Consultant, Tokyo"
  description="Cultural industries and communication consultant based in Tokyo. Founder of NODA.Tokyo and softpower.school. Spain–Japan–Europe cultural strategy and institutional communication."
>
  <Nav currentPage="home" />
  <main id="main-content" class="flex-1">

    <!-- ═══════════════════════════════════════
         MOMENT 1 — IDENTITY
         Full-height opening, name + title + Tokyo + CTA
    ════════════════════════════════════════════ -->
    <section class="moment-identity">
      <div class="wrap identity-inner">
        <div class="identity-text">
          <h1 class="identity-title">Cultural Industries &amp;<br>Communication Consultant</h1>
        </div>
        <div class="identity-footer">
          <span class="identity-location">Tokyo</span>
          <a href="/contact/" class="btn-primary">Get in touch&nbsp;&rarr;</a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         MOMENT 2 — FIELD OF WORK
         One large statement + softpower.school link
    ════════════════════════════════════════════ -->
    <section class="moment-field section border-top">
      <div class="wrap">
        <p class="field-statement">I work at the intersection of cultural policy, research and institutional communication across Spain, Japan and Europe.</p>
        <a href="https://www.softpower.school" target="_blank" rel="noopener" class="field-link">softpower.school&nbsp;&rarr;</a>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         MOMENT 3 — CREDIBILITY
         Institution logos only, no description
    ════════════════════════════════════════════ -->
    <section class="moment-institutions section border-top">
      <div class="wrap">
        <p class="section-label"><span class="section-symbol">&sect;</span> Institutions</p>
        <div class="logo-row" data-reveal>
          <img src="/images/logos/instituto-cervantes.svg" alt="Instituto Cervantes Tokyo" loading="lazy" />
          <img src="/images/logos/embassy-spain.svg" alt="Embassy of Spain in Japan" loading="lazy" />
          <img src="/images/logos/jica.svg" alt="JICA — Japan International Cooperation Agency" loading="lazy" />
          <img src="/images/logos/icex.svg" alt="ICEX — Spain Trade and Investment" loading="lazy" />
          <img src="/images/logos/utokyo.svg" alt="University of Tokyo" loading="lazy" />
          <img src="/images/logos/nhk.svg" alt="NHK" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         MOMENT 4 — NEXT STEP
         Three editorial navigation links
    ════════════════════════════════════════════ -->
    <section class="moment-nav section border-top">
      <div class="wrap">
        <nav class="editorial-nav">
          <a href="/about/" class="editorial-nav-link">
            <span class="editorial-nav-label">About</span>
            <span class="editorial-nav-arrow">&rarr;</span>
          </a>
          <a href="/work/" class="editorial-nav-link">
            <span class="editorial-nav-label">Work</span>
            <span class="editorial-nav-arrow">&rarr;</span>
          </a>
          <a href="/contact/" class="editorial-nav-link">
            <span class="editorial-nav-label">Contact</span>
            <span class="editorial-nav-arrow">&rarr;</span>
          </a>
        </nav>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<script>
  import { initHomeAnimations, initHoverPolish } from '../scripts/scroll-animations';
  initHomeAnimations();
  initHoverPolish();
</script>
