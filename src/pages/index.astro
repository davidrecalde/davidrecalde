---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const institutions = ['ICEX', 'Embassy of Spain in Japan', 'Instituto Cervantes Tokio', 'LaLiga', 'JICA', 'The University of Tokyo', 'NHK', 'Mahou', 'Solan de Cabras', 'COE', 'DAZN', 'J.League'];
---
<BaseLayout
  title="David Recalde — Cultural Industries & Communication Consultant, Tokyo"
  description="Cultural industries and communication consultant based in Tokyo. Founder of NODA and softpower.school. Spain–Japan–Europe cultural strategy and institutional communication."
>
  <Navigation />
  <main id="main-content" style="flex:1 0 auto">
    <div class="fade-up">

      <!-- Moment 1 — Identity -->
      <section class="wrap" style="padding-top:clamp(64px,12vh,120px);padding-bottom:clamp(56px,9vh,88px)">
        <h1 style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(38px,6.4vw,68px);line-height:1.08;letter-spacing:-0.01em;color:#111111;margin:0;max-width:16ch">
          Cultural Industries &amp; Communication Consultant
        </h1>
        <p style="font-family:'Inter',sans-serif;font-size:14px;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#767676;margin:22px 0 0">
          David Recalde
        </p>
        <p style="font-family:'Inter',sans-serif;font-size:17px;line-height:1.75;color:#111111;margin:28px 0 0;max-width:52ch">
          I work at the intersection of cultural policy, institutional communication and research practice &mdash; helping organisations understand and navigate the global cultural industries landscape.
        </p>
        <a href="/contact/" class="btn-primary"
          style="margin-top:30px;display:inline-flex;align-items:center;gap:8px;background:#C8102E;color:#fff;font-family:'Inter',sans-serif;font-size:14px;font-weight:500;padding:13px 24px;border:none;border-radius:4px;cursor:pointer;text-decoration:none">
          Get in touch &rarr;
        </a>
      </section>

      <!-- Moment 2 — Institutions (black band) -->
      <section style="background:#0A0A0A;padding:clamp(64px,10vh,96px) 0">
        <div class="wrap">
          <p style="font-family:'Inter',sans-serif;font-size:12px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#FFFFFF;margin:0 0 12px"><span style="color:#4A6FA5">&sect;</span> Organisations &amp; Institutions I have worked with</p>
          <p style="font-family:'Inter',sans-serif;font-size:13px;font-weight:400;color:rgba(255,255,255,0.6);margin:0 0 clamp(40px,6vw,56px);max-width:52ch">
            A decade of institutional collaboration in cultural diplomacy, communication and digital strategy.
          </p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:40px 28px;text-align:center">
            {institutions.map(name => (
              <p style="font-family:'Inter',sans-serif;font-weight:700;font-size:clamp(19px,2.4vw,25px);line-height:1.28;letter-spacing:0.01em;color:#FFFFFF;text-transform:uppercase;margin:0">{name}</p>
            ))}
          </div>
        </div>
      </section>

      <!-- Moment 3 — Editorial Nav -->
      <section class="wrap" style="padding-top:clamp(48px,8vw,72px);padding-bottom:clamp(64px,10vw,96px)">
        {[
          { label: 'About', href: '/about/' },
          { label: 'Work', href: '/work/' },
          { label: 'Essays', href: '/essays/' },
          { label: 'Contact', href: '/contact/' },
        ].map((item, i) => (
          <a href={item.href} class="ed-nav-link"
            style={`display:flex;align-items:center;justify-content:space-between;padding:24px 0;text-decoration:none${i < 3 ? ';border-bottom:1px solid #E5E5E5' : ''}`}>
            <span class="ed-label" style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(26px,4vw,38px);color:#B8B8B0;transition:color 0.2s ease">{item.label}</span>
            <span class="ed-arrow" style="font-size:20px;color:#B8B8B0">&rarr;</span>
          </a>
        ))}
      </section>

    </div>
  </main>
  <Footer />
</BaseLayout>
