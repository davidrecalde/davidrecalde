---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const education = [
  { degree: 'Master in SEO & Digital Marketing', institution: 'BIG School' },
  { degree: "Master's degree in Design", institution: 'Complutense University, Madrid' },
  { degree: 'Degree in Product Design', institution: 'EASD Valencia & Moholy-Nagy University, Budapest' },
  { degree: 'Master in 3D Animation and Digital Post-Production', institution: 'CICE, Madrid' },
  { degree: 'Technician in Plastic Arts and Design', institution: 'College of Design, Madrid' },
];

const institutions = [
  'Instituto Cervantes Tokyo',
  'Embassy of Spain in Japan',
  'JICA',
  'ICEX',
  'University of Tokyo',
  'NHK',
  'LaLiga',
  'Mahou',
  'Solán de Cabras',
];
---
<BaseLayout
  title="About — David Recalde · Cultural Industries Consultant"
  description="Background, bio and career of David Recalde — product design, digital communication and cultural industries research from Tokyo."
>
  <Navigation />
  <main id="main-content" class="fade-up">

    <!-- §01 Profile -->
    <section class="wrap" style="padding-top:clamp(48px,8vw,80px);padding-bottom:clamp(8px,2vw,16px)">
      <p class="sec-label">§ 01 Profile</p>
      <h1 style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(42px,7vw,64px);line-height:1.05;letter-spacing:-0.01em;color:#111111;margin:0 0 32px">About</h1>
    </section>

    <!-- Bio + Photo -->
    <section class="wrap" style="padding-bottom:clamp(56px,8vw,80px);border-bottom:1px solid #E5E5E5">
      <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:clamp(32px,5vw,56px);align-items:start">
        <div>
          <p style="font-family:'Inter',sans-serif;font-size:17px;line-height:1.85;color:#111111;margin:0 0 22px">David Recalde is a Cultural Industries &amp; Communication Consultant based in Tokyo. Born in Madrid in 1982, he studied Product Design in Valencia and Budapest before completing a Master&rsquo;s degree in Design at the Complutense University of Madrid.</p>
          <p style="font-family:'Inter',sans-serif;font-size:17px;line-height:1.85;color:#111111;margin:0 0 22px">His early career was shaped by a deep interest in the history and methodology of design, and a process that has always started with sketching &mdash; treating drawing not as a final output but as a tool for thinking. That curiosity later drew him toward new technologies applied to digital creation, as his practice expanded from physical products into communication, branding and digital strategy.</p>
          <p style="font-family:'Inter',sans-serif;font-size:17px;line-height:1.85;color:#111111;margin:0">Since relocating to Japan, his work has centred on cultural management, event production and institutional communication. He currently leads the studio at NODA and founded softpower.school, a research platform on cultural industries. He is available for select consulting engagements.</p>
        </div>
        <div style="width:100%;aspect-ratio:3/4;overflow:hidden;border-radius:4px">
          <img src="/images/david-recalde.jpg"
               alt="David Recalde — Cultural Industries & Communication Consultant, Tokyo"
               style="width:100%;height:100%;object-fit:cover;display:block">
        </div>
      </div>
    </section>

    <!-- §02 Education -->
    <section class="wrap" style="padding-top:clamp(40px,6vw,64px);padding-bottom:clamp(40px,6vw,64px);border-bottom:1px solid #E5E5E5">
      <p class="sec-label">§ 02 Education</p>
      {education.map(e => (
        <div style="padding:15px 0;border-bottom:1px solid #E5E5E5">
          <p style="font-family:'Inter',sans-serif;font-size:16px;font-weight:600;color:#111111;margin:0">{e.degree}</p>
          {e.institution && <p style="font-family:'Inter',sans-serif;font-size:13px;color:#767676;margin:4px 0 0">{e.institution}</p>}
        </div>
      ))}
    </section>

    <!-- §03 Knowledge Evolution -->
    <section class="wrap" style="padding-top:clamp(40px,6vw,64px);padding-bottom:clamp(40px,6vw,64px);border-bottom:1px solid #E5E5E5">
      <p class="sec-label">§ 03 A growing body of knowledge</p>
      <p style="font-family:'Inter',sans-serif;font-size:12px;color:#767676;margin:0 0 28px;font-style:italic">A growing body of knowledge &rarr;</p>
      <svg viewBox="0 0 760 200" width="100%" style="display:block;max-width:100%;height:auto;overflow:visible">
        <line x1="76" y1="100" x2="684" y2="100" stroke="#E5E5E5" stroke-width="1.5"/>
        <text x="700" y="105" font-family="Inter,sans-serif" font-size="14" fill="#767676">&rarr;</text>
        <g class="k-node" transform="translate(76,100)">
          <text y="-52" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="#E8A020" letter-spacing="0.04em">3D &amp; DIGITAL</text>
          <text y="-40" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="#E8A020" letter-spacing="0.04em">CREATION</text>
          <circle r="13" fill="#E8A020"/>
          <text y="30" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Animation</text>
          <text y="43" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Visualization</text>
          <text y="56" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Post-production</text>
        </g>
        <g class="k-node" transform="translate(228,100)">
          <text y="-52" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="#2D6A4F" letter-spacing="0.04em">PRODUCT &amp; INDUSTRIAL</text>
          <text y="-40" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="#2D6A4F" letter-spacing="0.04em">DESIGN</text>
          <circle r="13" fill="#2D6A4F"/>
          <text y="30" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Methodology</text>
          <text y="43" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Craft</text>
          <text y="56" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Systems thinking</text>
        </g>
        <g class="k-node" transform="translate(380,100)">
          <text y="-52" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="#C8102E" letter-spacing="0.04em">COMMUNICATION</text>
          <text y="-40" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="#C8102E" letter-spacing="0.04em">&amp; STRATEGY</text>
          <circle r="13" fill="#C8102E"/>
          <text y="30" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Branding</text>
          <text y="43" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Institutions</text>
          <text y="56" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Content</text>
        </g>
        <g class="k-node" transform="translate(532,100)">
          <text y="-52" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="#8B1A4A" letter-spacing="0.04em">CULTURAL</text>
          <text y="-40" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="#8B1A4A" letter-spacing="0.04em">INDUSTRIES</text>
          <circle r="13" fill="#8B1A4A"/>
          <text y="30" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Soft power</text>
          <text y="43" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Platforms</text>
          <text y="56" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Diplomacy</text>
        </g>
        <g class="k-node" transform="translate(684,100)">
          <text y="-52" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="#1A2B4A" letter-spacing="0.04em">RESEARCH</text>
          <text y="-40" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="#1A2B4A" letter-spacing="0.04em">&amp; PRACTICE</text>
          <circle r="13" fill="#1A2B4A"/>
          <text y="30" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">RtD</text>
          <text y="43" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Inquiry</text>
          <text y="56" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#767676">Methodology</text>
        </g>
      </svg>
    </section>

    <!-- §04 How I work -->
    <section class="wrap" style="padding-top:clamp(40px,6vw,64px);padding-bottom:clamp(40px,6vw,64px);border-bottom:1px solid #E5E5E5">
      <p class="sec-label">§ 04 How I work</p>
      <p style="font-family:'Inter',sans-serif;font-size:17px;line-height:1.85;color:#111111;max-width:56ch;margin:0">
        Every project starts with a question, not a solution. I bring together design thinking, research practice and institutional knowledge to find answers that are strategic, grounded and built to last.
      </p>
    </section>

    <!-- §05 Organisations -->
    <section class="wrap" style="padding-top:clamp(40px,6vw,64px);padding-bottom:clamp(56px,8vw,80px)">
      <p class="sec-label">§ 05 Organisations &amp; Institutions</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px 32px;align-items:center;margin-bottom:36px">
        {institutions.map(name => (
          <span style="font-family:'Inter',sans-serif;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#B8B8B0">{name}</span>
        ))}
      </div>
      <a href="/work/" class="btn-secondary"
        style="display:inline-flex;align-items:center;gap:8px;background:#fff;color:#111;font-family:'Inter',sans-serif;font-size:14px;font-weight:500;padding:12px 22px;border:1px solid #111;border-radius:4px;cursor:pointer;text-decoration:none">
        Explore my work &rarr;
      </a>
    </section>

  </main>
  <Footer />
</BaseLayout>
