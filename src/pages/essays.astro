---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const essays = [
  { date: 'August 2026', readTime: '6 min read', title: 'On soft power and the cultural economy of Japan', excerpt: "What makes a country's culture genuinely influential beyond its borders? An examination of Japan's creative industries and the mechanisms that have made them global reference points.", color: '#8B1A4A' },
  { date: 'July 2026', readTime: '5 min read', title: 'Research through Design as institutional practice', excerpt: 'How the RtD methodology — born in product design — applies to the challenges of cultural diplomacy and cross-cultural communication.', color: '#1A2B4A' },
  { date: 'June 2026', readTime: '4 min read', title: 'What communication strategy borrows from industrial design', excerpt: 'The methodological connections between designing physical objects and designing communication systems for complex organisations.', color: '#2D6A4F' },
];
---
<BaseLayout
  title="Essays — David Recalde"
  description="Reflections on cultural industries, communication and design research. Written from Tokyo."
>
  <Navigation />
  <main id="main-content" class="fade-up">
    <section class="wrap" style="padding-top:clamp(48px,8vw,80px);padding-bottom:clamp(8px,2vw,16px)">
      <p class="sec-label">§ 01 Essays</p>
      <h1 style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(42px,7vw,64px);line-height:1.05;letter-spacing:-0.01em;color:#111111;margin:0 0 24px">Essays</h1>
      <p style="font-family:'Inter',sans-serif;font-size:17px;line-height:1.85;color:#767676;max-width:56ch;margin:0">
        An ongoing series of essays on the intersections of cultural policy, digital communication, soft power and design methodology. Written from Tokyo.
      </p>
    </section>
    <section class="wrap" style="padding-top:clamp(24px,4vw,40px);padding-bottom:clamp(56px,8vw,80px)">
      {essays.map(e => (
        <div style="padding:30px 0;border-bottom:1px solid #E5E5E5">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
            <span style={`width:8px;height:8px;border-radius:50%;background:${e.color};flex-shrink:0`}></span>
            <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:#767676">{e.date} &middot; {e.readTime}</span>
          </div>
          <p class="essay-title" style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(24px,3.2vw,30px);line-height:1.25;color:#111111;margin:0 0 10px;cursor:pointer">{e.title}</p>
          <p style="font-family:'Inter',sans-serif;font-size:15px;line-height:1.7;color:#767676;margin:0;max-width:64ch">{e.excerpt}</p>
        </div>
      ))}
      <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:15px;color:#B8B8B0;margin:28px 0 0">More essays coming soon.</p>
    </section>
  </main>
  <Footer />
</BaseLayout>
