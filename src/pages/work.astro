---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const services = [
  { title: 'Culture', color: '#8B1A4A', desc: 'Understanding how cultural industries operate as instruments of influence — and helping organisations navigate that landscape strategically.' },
  { title: 'Research', color: '#1A2B4A', desc: 'Applying design as a method for inquiry — building knowledge through practice at the intersection of cultural policy and communication.' },
  { title: 'Communication', color: '#C8102E', desc: 'Designing messages, identities and digital systems for institutions and organisations that need to communicate with clarity and purpose.' },
];

const projects = [
  { name: 'Instituto Cervantes Tokyo', sector: 'Cultural Institution', country: 'Japan', services: 'Marketing & Events', description: "Led marketing, social media, events and content strategy for Spain's official cultural institution in Japan over four years." },
  { name: 'Embassy of Spain in Japan', sector: 'Government', country: 'Japan', services: 'Audiovisual & Design', description: 'Promotional materials, audiovisual content and institutional design for cultural exhibitions and events.' },
  { name: 'JICA', sector: 'Government Agency', country: 'Japan', services: 'Language Programs', description: "Designed and delivered Spanish language programs for Japanese professionals at Japan's official cooperation agency." },
  { name: 'ICEX', sector: 'Trade & Investment', country: 'Japan', services: 'Institutional Comms', description: "Institutional communication and digital strategy for Spain's trade promotion in Japan." },
  { name: 'University of Tokyo', sector: 'Academic', country: 'Japan', services: 'Graphic & Digital Materials', description: 'Graphic and digital materials for scientific publications of the Faculty of Engineering.' },
  { name: 'NODA', sector: 'Studio', country: 'Japan', services: 'Brand & Comms (Founder)', description: 'Lead brand and communication projects combining strategy, branding and digital design.' },
  { name: 'softpower.school', sector: 'Research & Education', country: 'Japan', services: 'Research Platform (Founder)', description: 'Platform for the analysis of cultural industries as soft power instruments.' },
  { name: 'Club Español en Japón スペイン倶楽部', sector: 'Own Platform', country: 'Japan', services: 'Media & SEO (Founder)', description: 'Japanese-language cultural media platform about Spain — brand, SEO, editorial strategy.' },
];
---
<BaseLayout
  title="Work — David Recalde"
  description="Services, research and institutional collaborations: cultural industries strategy, digital communication and design research."
>
  <Navigation />
  <main id="main-content" class="fade-up">

    <!-- Header -->
    <section class="wrap" style="padding-top:clamp(48px,8vw,80px);padding-bottom:clamp(8px,2vw,16px)">
      <p class="sec-label">Work</p>
      <h1 style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(42px,7vw,64px);line-height:1.05;letter-spacing:-0.01em;color:#111111;margin:0 0 24px">
        Services, research and collaboration
      </h1>
    </section>

    <!-- §01 What I do -->
    <section class="wrap" style="padding-top:clamp(24px,4vw,40px);padding-bottom:clamp(48px,7vw,56px);border-bottom:1px solid #E5E5E5">
      <p class="sec-label">§ 01 What I do</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:clamp(28px,4vw,40px);margin-bottom:clamp(40px,6vw,56px)">
        {services.map(s => (
          <div style={`border-top:4px solid ${s.color};padding-top:20px`}>
            <h3 style="font-family:'Inter',sans-serif;font-weight:600;font-size:18px;line-height:1.3;color:#111111;margin:0 0 12px">{s.title}</h3>
            <p style="font-family:'Inter',sans-serif;font-size:15px;line-height:1.7;color:#767676;margin:0">{s.desc}</p>
          </div>
        ))}
      </div>
      <div style="background:#F0EDE6;padding:clamp(24px,4vw,40px);border-radius:4px">
        <svg viewBox="0 0 700 500" width="100%" style="display:block;max-width:620px;margin:0 auto;overflow:visible">
          <circle cx="350" cy="170" r="160" fill="#8B1A4A" opacity="0.6"/>
          <circle cx="428" cy="305" r="160" fill="#C8102E" opacity="0.6"/>
          <circle cx="272" cy="305" r="160" fill="#1A2B4A" opacity="0.6"/>
          <text x="350" y="90" text-anchor="middle" font-family="Inter,sans-serif" font-size="19" font-weight="700" fill="#fff">Culture</text>
          <text x="350" y="112" text-anchor="middle" font-family="Inter,sans-serif" font-size="11.5" fill="#fff" opacity="0.9">Understanding how cultural industries</text>
          <text x="350" y="128" text-anchor="middle" font-family="Inter,sans-serif" font-size="11.5" fill="#fff" opacity="0.9">operate as influence</text>
          <text x="476" y="358" text-anchor="middle" font-family="Inter,sans-serif" font-size="19" font-weight="700" fill="#fff">Research</text>
          <text x="476" y="380" text-anchor="middle" font-family="Inter,sans-serif" font-size="11.5" fill="#fff" opacity="0.9">Design as a method for inquiry</text>
          <text x="476" y="396" text-anchor="middle" font-family="Inter,sans-serif" font-size="11.5" fill="#fff" opacity="0.9">and knowledge</text>
          <text x="224" y="358" text-anchor="middle" font-family="Inter,sans-serif" font-size="19" font-weight="700" fill="#fff">Communication</text>
          <text x="224" y="380" text-anchor="middle" font-family="Inter,sans-serif" font-size="11.5" fill="#fff" opacity="0.9">Shaping messages, identities</text>
          <text x="224" y="396" text-anchor="middle" font-family="Inter,sans-serif" font-size="11.5" fill="#fff" opacity="0.9">and institutions</text>
          <text x="350" y="266" text-anchor="middle" font-family="Inter,sans-serif" font-size="20" font-weight="700" fill="#fff">DESIGN</text>
        </svg>
      </div>
    </section>

    <!-- §02 Research & Practice (black) -->
    <section style="background:#0A0A0A;padding:clamp(48px,7vw,64px) 0">
      <div class="wrap">
        <p class="sec-label white">§ 02 Research &amp; Practice</p>
        <div style="display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,56px);align-items:center">
          <div style="flex:1 1 380px;min-width:260px">
            <p style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(22px,3vw,28px);line-height:1.55;color:#fff;margin:0 0 26px;max-width:44ch">
              Beyond consulting, I develop research on the mechanisms of cultural soft power in international cooperation. This work connects institutional communication practice with a broader inquiry into how cultural industries operate as instruments of influence.
            </p>
            <div style="display:flex;gap:clamp(24px,4vw,48px);flex-wrap:wrap;margin-bottom:24px">
              <div>
                <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#8A8A85;margin:0 0 8px">Field</p>
                <p style="font-family:'Inter',sans-serif;font-size:15px;color:#fff;margin:0">Cultural Industries &middot; Soft Power &middot; Cross-cultural Communication</p>
              </div>
              <div>
                <p style="font-family:'Inter',sans-serif;font-size:11px;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#8A8A85;margin:0 0 8px">Practice</p>
                <p style="font-family:'Inter',sans-serif;font-size:15px;color:#fff;margin:0">Research through Design</p>
              </div>
            </div>
          </div>
          <div style="flex:0 1 380px;min-width:300px;margin:0 auto">
            <svg viewBox="0 0 380 330" width="100%" style="display:block;margin:0 auto;overflow:visible">
              <path d="M190 65 A95 95 0 0 1 285 160" fill="none" stroke="#C8102E" stroke-width="1.5"/>
              <path d="M285 160 A95 95 0 0 1 190 255" fill="none" stroke="#8B1A4A" stroke-width="1.5"/>
              <path d="M190 255 A95 95 0 0 1 95 160" fill="none" stroke="#E8A020" stroke-width="1.5"/>
              <path d="M95 160 A95 95 0 0 1 190 65" fill="none" stroke="#2D6A4F" stroke-width="1.5"/>
              <circle cx="190" cy="65" r="10" fill="#C8102E"/>
              <circle cx="285" cy="160" r="10" fill="#8B1A4A"/>
              <circle cx="190" cy="255" r="10" fill="#E8A020"/>
              <circle cx="95" cy="160" r="10" fill="#2D6A4F"/>
              <text x="190" y="34" text-anchor="middle" font-family="Inter,sans-serif" font-size="15" font-weight="600" letter-spacing="0.06em" fill="#fff">1. RESEARCH</text>
              <text x="190" y="50" text-anchor="middle" font-family="Inter,sans-serif" font-size="11" fill="#fff" opacity="0.75">Formulating the question</text>
              <text x="304" y="152" text-anchor="start" font-family="Inter,sans-serif" font-size="15" font-weight="600" letter-spacing="0.06em" fill="#fff">2. OBSERVATION</text>
              <text x="304" y="170" text-anchor="start" font-family="Inter,sans-serif" font-size="11" fill="#fff" opacity="0.75">Gathering evidence</text>
              <text x="190" y="292" text-anchor="middle" font-family="Inter,sans-serif" font-size="15" font-weight="600" letter-spacing="0.06em" fill="#fff">3. INSIGHT</text>
              <text x="190" y="308" text-anchor="middle" font-family="Inter,sans-serif" font-size="11" fill="#fff" opacity="0.75">Finding meaning</text>
              <text x="76" y="152" text-anchor="end" font-family="Inter,sans-serif" font-size="15" font-weight="600" letter-spacing="0.06em" fill="#fff">4. PRACTICE</text>
              <text x="76" y="170" text-anchor="end" font-family="Inter,sans-serif" font-size="11" fill="#fff" opacity="0.75">Applying through design</text>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- §03 Projects accordion -->
    <section class="wrap" style="padding-top:clamp(48px,7vw,64px);padding-bottom:clamp(64px,9vw,88px)">
      <p class="sec-label">§ 03 Projects &amp; initiatives</p>
      <div style="display:grid;grid-template-columns:2fr 1.3fr 1fr 1.6fr;gap:0;padding:0 0 12px;border-bottom:1px solid #111111">
        {['Institution','Sector','Country','Services'].map(h => (
          <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#767676">{h}</span>
        ))}
      </div>
      {projects.map((p, i) => (
        <div class="proj-item" style="border-bottom:1px solid #E5E5E5">
          <div class="proj-row" data-index={i}
            style="display:grid;grid-template-columns:2fr 1.3fr 1fr 1.6fr;gap:0;padding:16px 0;cursor:pointer;align-items:center">
            <span style="font-family:'Inter',sans-serif;font-size:15px;font-weight:500;color:#111111">{p.name}</span>
            <span style="font-family:'Inter',sans-serif;font-size:14px;color:#767676">{p.sector}</span>
            <span style="font-family:'Inter',sans-serif;font-size:14px;color:#767676">{p.country}</span>
            <span style="font-family:'Inter',sans-serif;font-size:14px;color:#767676;display:flex;align-items:center;justify-content:space-between;gap:6px">
              {p.services}<span class="proj-arrow">&darr;</span>
            </span>
          </div>
          <div class="proj-panel" style="padding-bottom:16px">
            <p style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.7;color:#111111;margin:0;max-width:68ch">{p.description}</p>
          </div>
        </div>
      ))}
    </section>

  </main>
  <Footer />
</BaseLayout>

<script>
  document.querySelectorAll('.proj-row').forEach(row => {
    row.addEventListener('click', () => {
      const isOpen = row.classList.contains('open');
      document.querySelectorAll('.proj-row.open').forEach(r => r.classList.remove('open'));
      if (!isOpen) row.classList.add('open');
    });
  });
</script>
